# ---------- Pflicht ----------

# Öffentliche IPv4-Adresse des Servers (für TURN und, ohne Domain, als Adresse der App)
PUBLIC_IP=203.0.113.10

# Langer Zufallswert für TURN. Erzeugen mit:  openssl rand -hex 32
TURN_SECRET=

# ---------- Optional ----------

# Name in der Serverliste der App
SERVER_NAME=Brinkgame Server

# Passwort, das jeder zum Verbinden braucht. Leer = offen für alle, die die Adresse kennen.
SERVER_PASSWORD=

MAX_LOBBIES=50

# ---------- Nur mit Domain (HTTPS) ----------
# Nötig, wenn Spieler im Browser (z. B. iPad) mit Mikrofon und Kamera mitspielen sollen.
# Die Domain muss per DNS-A-Eintrag auf PUBLIC_IP zeigen.
# Start dann mit:  docker compose --profile https up -d --build
# Beide Zeilen einkommentieren:
#DOMAIN=brink.example.de
#HTTP_BIND=127.0.0.1
