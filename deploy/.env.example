# Adresse, unter der der Server erreichbar ist (DNS-A-Eintrag muss auf den Server zeigen)
DOMAIN=brink.example.de

# Öffentliche IPv4-Adresse des Servers (für TURN)
PUBLIC_IP=203.0.113.10

# Langer Zufallswert für TURN. Erzeugen mit:  openssl rand -hex 32
TURN_SECRET=

# Name in der Serverliste der App
SERVER_NAME=Brinkgame Server

# Optional: Passwort, das jeder zum Verbinden braucht. Leer = offen für alle, die die Adresse kennen.
SERVER_PASSWORD=

MAX_LOBBIES=50
